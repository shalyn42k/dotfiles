#!/usr/bin/env bash
# rigdo — риг-зависимый диспетчер действий для горячего переключения.
# Бинды всех ригов зовут `rigdo <action>`; команда выбирается по активному
# профилю (profiles/active), а не по тому, с чем стартовала сессия.
#
# Так одна комба контракта (KEYBINDS.md §2.1) означает своё в каждом риге,
# и на свитче её не надо переставлять — меняется только результат.
set -u

ACTIVE="$(basename "$(readlink -f "$HOME/dotfiles/profiles/active")" 2>/dev/null || echo caelestia)"
SERP="$HOME/dotfiles/profiles/serpantinum/shell/bin/serpantinum"

hint() { notify-send -u low "rigdo" "$1"; }

# global-диспатчер caelestia-шелла. Все риги теперь на lua-провайдере, поэтому
# проверка движка ушла — при hyprlang-риге здесь был второй синтаксис.
hypr_global() { hyprctl dispatch "hl.dsp.global(\"$1\")"; }

case "${1:-}" in
    launcher)
        if [[ "$ACTIVE" == serpantinum ]]; then "$SERP" msg toggle launcher
        else caelestia shell drawers toggle launcher; fi ;;
    wallpaper)
        if [[ "$ACTIVE" == serpantinum ]]; then "$SERP" msg toggle wallpaper
        else hint "wallpaper picker: caelestia uses its own scheme, see SUPER+SHIFT+N"; fi ;;
    settings)
        # в serpantinum отдельного таргета "settings" нет: qs_manager.sh отдаёт
        # только "guide" — тот же экран (WindowRegistry.js: id "guide", name "Settings")
        if [[ "$ACTIVE" == serpantinum ]]; then hint "settings are the guide screen (SUPER+H)"
        else hint "no settings panel in caelestia"; fi ;;
    music)
        if [[ "$ACTIVE" == serpantinum ]]; then "$SERP" msg toggle music
        else hint "no music widget in caelestia (feishin: SUPER+Z)"; fi ;;
    calendar)
        if [[ "$ACTIVE" == serpantinum ]]; then "$SERP" msg toggle calendar
        else hint "no calendar widget in caelestia"; fi ;;
    movies)
        if [[ "$ACTIVE" == serpantinum ]]; then hint "no movies widget in serpantinum"
        else hint "no movies widget in this rig"; fi ;;
    clipboard)
        if [[ "$ACTIVE" == serpantinum ]]; then "$SERP" msg toggle clipboard
        else pkill fuzzel || caelestia clipboard; fi ;;
    screenshot)
        if [[ "$ACTIVE" == serpantinum ]]; then "$SERP" screenshot
        else hypr_global caelestia:screenshotFreeze; fi ;;
    lock)
        if [[ "$ACTIVE" == serpantinum ]]; then "$SERP" lock
        else hypr_global caelestia:lock; fi ;;
    shell)  # рестарт шелла активного рига
        if [[ "$ACTIVE" == serpantinum ]]; then
            "$SERP" reload
        else
            qs -c caelestia kill; qs -c caelestia -d
        fi ;;
    battery)
        # отдельного виджета батареи в serpantinum нет — заряд показан внутри
        # системной панели (compositors/hyprland/config/keybinds.lua: SUPER+B → toggle system)
        if [[ "$ACTIVE" == serpantinum ]]; then hint "battery lives in the system panel (SUPER+B)"
        else hint "no battery widget in caelestia"; fi ;;
    network)
        if [[ "$ACTIVE" == serpantinum ]]; then "$SERP" msg toggle network
        else hint "no network widget in caelestia"; fi ;;
    guide)
        if [[ "$ACTIVE" == serpantinum ]]; then "$SERP" msg toggle guide
        else hint "no guide in caelestia (keybinds: SUPER+T)"; fi ;;
    *) echo "usage: rigdo launcher|wallpaper|settings|music|calendar|movies|clipboard|screenshot|lock|shell|battery|network|guide" >&2; exit 1 ;;
esac
