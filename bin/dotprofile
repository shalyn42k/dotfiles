#!/usr/bin/env bash
# dotprofile — переключатель риг-профилей (см. docs/specs/2026-07-13-*.md)
set -euo pipefail

DOTFILES="$HOME/dotfiles"
PROFILES="$DOTFILES/profiles"
ACTIVE="$PROFILES/active"
CONTESTED=(hypr gtk-3.0 gtk-4.0 qt5ct qt6ct matugen)
# OPTIONAL_LINKS — каталоги, которые есть НЕ у всех ригов. Формат
# «источник-в-профиле:цель-в-.config». ensure_links ставит симлинк, если у
# активного рига каталог есть, иначе снимает наш симлинк и возвращает бэкап.
#
# Сейчас пуст: все записи были end4-эксклюзивом (ii-шелл, его Qt- и
# шрифт-тема), а риг удалён 2026-09-02. Механика оставлена — serpantinum
# приедет со своим набором каталогов.
OPTIONAL_LINKS=()

usage() {
    echo "usage: dotprofile switch <name> [--links-only] | menu | status | doctor | update <name>" >&2
    exit 1
}

current() { [[ -L "$ACTIVE" ]] && basename "$(readlink -f "$ACTIVE")"; }

list_profiles() {
    find "$PROFILES" -mindepth 1 -maxdepth 1 -type d -printf '%f\n' | sort
}

ensure_links() {
    local missing=()
    for d in "${CONTESTED[@]}"; do
        # CONTESTED обязателен по контракту рига. Раньше симлинк ставился
        # безусловно: если каталога у рига нет, в ~/.config оставался битый
        # симлинк, и всё, что туда пишет, тихо падало. Так у end4 пропала
        # GTK4-тема целиком — его matugen рендерил gtk.css в никуда.
        if [[ ! -d "$PROFILES/active/$d" ]]; then
            missing+=("$d")
            continue
        fi
        # реальный каталог (не наш симлинк) — снести, иначе ln положит симлинк
        # ВНУТРЬ (напр. ~/.config/matugen/matugen). matugen/end4 сюда попадали.
        [[ -e "$HOME/.config/$d" && ! -L "$HOME/.config/$d" ]] && rm -rf "$HOME/.config/${d:?}"
        ln -sfn "$PROFILES/active/$d" "$HOME/.config/$d"
    done
    if (( ${#missing[@]} )); then
        echo "ensure_links: у рига '$(current)' нет обязательных каталогов: ${missing[*]}" >&2
        echo "  темы, которые туда рендерятся, применяться не будут (см. dotprofile doctor)" >&2
    fi
    # Опциональные — ставим/снимаем по наличию у активного рига.
    local pair src dst target link
    for pair in "${OPTIONAL_LINKS[@]}"; do
        src="${pair%%:*}"; dst="${pair##*:}"
        target="$PROFILES/active/$src"
        link="$HOME/.config/$dst"
        if [[ -d "$target" ]]; then
            mkdir -p "$(dirname "$link")"
            # чужой РЕАЛЬНЫЙ каталог не затираем — бэкапим один раз
            [[ -e "$link" && ! -L "$link" ]] && mv "$link" "$link.pre-rig"
            ln -sfn "$target" "$link"
        else
            # активный риг каталога не имеет — убрать наш симлинк, вернуть бэкап
            [[ -L "$link" ]] && rm -f "$link"
            [[ -e "$link.pre-rig" ]] && mv "$link.pre-rig" "$link"
        fi
    done
    # Последняя пара может кончиться ложным [[ -e ]] (риг без опц-каталога,
    # напр. caelestia без kde-material-you-colors) — тогда функция вернула бы 1
    # на ровном месте. Поэтому итог считаем ЯВНО и только по CONTESTED:
    # отсутствие опционального каталога — норма, обязательного — нет.
    (( ${#missing[@]} == 0 ))
}

# Цвет рамок окон задаётся конфиг-движком при старте сессии; при горячем
# свитче применяем цвета активного рига runtime-командой (lua: eval hl.config).
# Источники: colors.conf (риг со своим matugen — serpantinum) или
# scheme/current.lua (caelestia: primary/onSurfaceVariant).
apply_rig_colors() {
    local name="$1" active="" inactive="" accent_hex=""
    local cconf="$PROFILES/$name/hypr/colors.conf"
    local clua="$PROFILES/$name/hypr/scheme/current.lua"
    if [[ -f "$cconf" ]]; then
        active="$(awk -F' = ' '/^\$active_border/{print $2}' "$cconf")"
        inactive="$(awk -F' = ' '/^\$inactive_border/{print $2}' "$cconf")"
    elif [[ -f "$clua" ]] && command -v luajit >/dev/null; then
        local p osv
        read -r p osv < <(luajit -e "local s=dofile('$clua') print(s.primary, s.onSurfaceVariant)" 2>/dev/null) || true
        [[ -n "${p:-}" && -n "${osv:-}" ]] && { active="rgba(${p}e6)"; inactive="rgba(${osv}11)"; }
    fi
    [[ -n "$active" && -n "$inactive" ]] || return 0

    hyprctl eval "hl.config({
        general = { col = { active_border = '$active', inactive_border = '$inactive' } },
        group = { col = {
            border_active = '$active', border_inactive = '$inactive',
            border_locked_active = '$active', border_locked_inactive = '$inactive',
        } },
    })" >/dev/null || true

    # fastfetch: акцент рига в конфиг из шаблона (truecolor 38;2;R;G;B)
    local tmpl="$DOTFILES/.config/fastfetch/config.jsonc.template"
    local hex="${accent_hex:-}"
    if [[ -z "$hex" ]]; then
        hex="${active#rgba(}"; hex="${hex#rgb(}"; hex="${hex%)}"
    fi
    hex="${hex#\#}"; hex="${hex:0:6}"
    if [[ -f "$tmpl" && "$hex" =~ ^[0-9a-fA-F]{6}$ ]]; then
        local r=$((16#${hex:0:2})) g=$((16#${hex:2:2})) b=$((16#${hex:4:2}))
        # два прохода: сниппет рига вставляется первым (текст из r-файла не
        # проходит через s-команды того же sed), акцент красит и сниппет
        sed -e "/{{RIG_MODULES}}/r $PROFILES/$name/fastfetch.modules" \
            -e "/{{RIG_MODULES}}/d" "$tmpl" \
            | sed "s/{{ACCENT}}/38;2;$r;$g;$b/g" \
            > "$DOTFILES/.config/fastfetch/config.jsonc"
    fi

    # Vencord-тема Discord (rig.theme.css в vesktop/equibop): контент по ригу.
    # Если у рига есть свой matugen (обновляется со сменой обоев) — берём его
    # вывод по имени рига, а не захардкоженный список. Раньше тут проверялось
    # только один захардкоженный риг, из-за чего у остальных тема молча
    # падала на дефолт caelestia.
    local dsrc="$HOME/.cache/matugen/discord-$name.theme.css"
    [[ -f "$dsrc" ]] || dsrc="$PROFILES/caelestia/discord.theme.css"
    if [[ -f "$dsrc" ]]; then
        local client
        for client in vesktop equibop Vencord; do
            [[ -d "$HOME/.config/$client/themes" ]] && cp "$dsrc" "$HOME/.config/$client/themes/rig.theme.css"
        done
    fi

    # Obsidian: CSS-сниппет rig-theme в вольте, контент по ригу (как Discord)
    local vault="$HOME/Documents/Obsidian Vault/Shalyn_Vault"
    local osrc="$HOME/.cache/matugen/obsidian-$name.css"
    [[ -f "$osrc" ]] || osrc="$PROFILES/caelestia/obsidian.css"
    if [[ -d "$vault/.obsidian" && -f "$osrc" ]]; then
        mkdir -p "$vault/.obsidian/snippets"
        cp "$osrc" "$vault/.obsidian/snippets/rig-theme.css"
    fi

    # Запущенные GTK-приложения (Thunar и пр.) не перечитывают gtk.css сами —
    # форсим перепарс каскада переключением темы туда-обратно (краткий блик
    # Adwaita, зато цвета применяются без рестарта приложений).
    local gtheme
    gtheme="$(awk -F= '/^gtk-theme-name/{print $2}' "$PROFILES/$name/gtk-3.0/settings.ini" 2>/dev/null)"
    if [[ -n "$gtheme" ]] && command -v gsettings >/dev/null; then
        gsettings set org.gnome.desktop.interface gtk-theme Adwaita 2>/dev/null || true
        sleep 0.2
        gsettings set org.gnome.desktop.interface gtk-theme "$gtheme" 2>/dev/null || true
    fi
}

hypr_provider() {
    hyprctl systeminfo 2>/dev/null | awk -F': ' '/configProvider/{print $2}'
}

# Движок конфига рига: lua если есть hyprland.lua, иначе hyprlang.
rig_engine() {
    [[ -f "$PROFILES/$1/hypr/hyprland.lua" ]] && echo lua || echo hyprlang
}

# Запомнить последний lua-риг — читает legacy-запись hyprland-lua
# (start-hyprland-profile --lua). Единая запись hyprland-rig берёт риг из
# profiles/active и в этом файле не нуждается.
write_last_lua() {
    [[ "$(rig_engine "$1")" == lua ]] && echo "$1" > "$PROFILES/.last-lua" || true
}

# Кросс-движковый переход невозможен в живой сессии (Hyprland фиксирует
# движок при старте). Готовим релогин: active уже переключён вызывающим,
# просим Hyprland выйти. Функция возвращается как обычно — падения в горячий
# свитч не будет, т.к. вызывающий cmd_switch делает return 0 сразу после
# trigger_relogin.
#
# Целевой риг несёт profiles/active, и единственная SDDM-запись
# (hyprland-rig -> start-hyprland-profile --auto) его читает.
#
# Раньше здесь писался ~/.dmrc с именем целевой сессии. SDDM его НЕ читает —
# он держит последнюю сессию в root-овом /var/lib/sddm/state.conf, — поэтому
# запись была холостой: релогин приземлялся в ту сессию, что SDDM запомнил,
# а её Exec переставлял active обратно. Кросс-движковый свитч из-за этого
# всегда возвращал в исходный риг. Проверено по journal 2026-09-02:
#   13:40:09  ~/.dmrc = hyprland-lua
#   13:41:00  Session "hyprland-<другой риг>.desktop" selected
trigger_relogin() {
    local name="$1"
    write_last_lua "$name"
    echo "relogin -> $name; выхожу в SDDM..."
    systemctl --user stop graphical-session.target 2>/dev/null || true
    sleep 0.3
    if [[ "$(hypr_provider)" == lua ]]; then
        hyprctl dispatch 'hl.dsp.exit()'
    else
        hyprctl dispatch exit
    fi
}

# Анимации живут в конфиг-движке — применяем набор активного рига runtime.
# Свитч теперь только lua↔lua, поэтому единственная ветка — lua.
apply_rig_animations() {
    local name="$1"
    local chunk="$PROFILES/$name/animations-runtime.lua"
    [[ -f "$chunk" ]] && hyprctl eval "dofile('$chunk')" >/dev/null || true
}

# Бинды рига — меняются в рантайме через реестр владения
# (.config/hypr-shared/rigbinds.lua). Спека:
# docs/superpowers/specs/2026-09-02-rig-switch-binds-ownership-design.md
#
# Порядок внутри чанка важен:
#   1. reset_modules — package.loaded держит variables/functions СТАРОГО рига,
#      без сброса dofile подтянет чужие значения;
#   2. own(<новый>) — сначала ПОСТАВИТЬ новый набор;
#   3. drop(<старый>) — и только если загрузка прошла. Обратный порядок при
#      падении оставил бы систему без клавиатуры;
#   4. контракт последним — набор рига мог занять его комбы (ii-дефолты вешают
#      SUPER+B, SUPER+N, SUPER+M), а контракт снимает комбу перед своей.
apply_rig_binds() {
    local old="$1" new="$2"
    local files=() f
    # Список покрывает формы, в которых разные риги хранят бинды: caelestia/
    # разные риги кладут их под hypr/hyprland или hypr/custom, serpantinum —
    # одним файлом hypr/overrides.lua. Рига без нужного файла просто не имеет —
    # [[ -f ]] отсеивает недостающее, дублировать список под каждый риг не надо.
    for f in "$PROFILES/$new/hypr/hyprland/keybinds.lua" \
             "$PROFILES/$new/hypr/custom/keybinds.lua" \
             "$PROFILES/$new/hypr/overrides.lua"; do
        [[ -f "$f" ]] && files+=("$f")
    done
    (( ${#files[@]} )) || { echo "apply_rig_binds: у рига '$new' нет файлов биндов" >&2; return 1; }

    local loads=""
    for f in "${files[@]}"; do loads+="dofile('$f') "; done

    local status; status="$(mktemp)"
    hyprctl eval "
        local st
        if __rig and __rig.own then
            __rig.reset_modules()
            if __rig.own('$new', function() $loads end) then
                __rig.drop('$old')
                st = 'ok'
            else
                st = 'load-failed'
            end
            dofile('$DOTFILES/.config/hypr-shared/contract-binds.lua')
        else
            st = 'no-registry'
        end
        local h = io.open('$status', 'w') h:write(st) h:close()
    " >/dev/null 2>&1

    local result; result="$(cat "$status" 2>/dev/null || true)"
    rm -f "$status"
    case "$result" in
        ok) return 0 ;;
        no-registry)
            # Сессия стартовала до появления прелюдии в hyprland.lua рига.
            echo "apply_rig_binds: в этой сессии нет реестра биндов — нужен один релогин" >&2
            return 1 ;;
        load-failed)
            echo "apply_rig_binds: набор рига '$new' не загрузился; прежние бинды сохранены" >&2
            return 1 ;;
        *)
            echo "apply_rig_binds: hyprctl eval не ответил (риг '$new')" >&2
            return 1 ;;
    esac
}

# Window/workspace-правила рига — применяем набор целевого рига в рантайме
# (mirror apply_rig_animations). Целевые добавляются последними → выигрывают
# конфликтные (opacity/blur общих классов). Старые правила рига лингерят, но
# целят классы уже закрытого чужого шелла. Идеально чисто — на релогине.
apply_rig_rules() {
    local name="$1"
    local chunk="$PROFILES/$name/rules-runtime.lua"
    [[ -f "$chunk" ]] && hyprctl eval "dofile('$chunk')" >/dev/null || true
}

# Одна стадия свитча. Печатает `stage <имя> ok|fail` в stdout — это контракт с
# оверлеем rigswitch: он анимирует сборку рига по реальным событиям, а не по
# таймеру вслепую. Провал стадии больше не немой, но и не фатальный: остальные
# слои применить всё равно нужно.
SWITCH_FAILED=0
stage() {
    local name="$1"; shift
    if "$@"; then
        echo "stage $name ok"
    else
        echo "stage $name fail"
        SWITCH_FAILED=1
    fi
}

cmd_switch() {
    local name="${1:-}"; [[ -n "$name" ]] || usage
    local links_only="${2:-}"
    [[ -d "$PROFILES/$name" ]] || { echo "no such profile: $name" >&2; exit 1; }
    local old; old="$(current || true)"

    ln -sfn "$name" "$ACTIVE"
    stage links ensure_links

    if [[ "$links_only" == "--links-only" ]]; then
        echo "active: $name"
        return 0
    fi

    # Кросс-движковый переход — только через релогин (не возвращается).
    if command -v hyprctl >/dev/null; then
        local target running
        target="$(rig_engine "$name")"
        running="$(hypr_provider)"
        if [[ -n "$running" && "$running" != "$target" ]]; then
            trigger_relogin "$name"
            return 0
        fi
    fi

    # ── Одномувижковый горячий свитч, стадиями ──
    #
    # Порядок не произвольный. links (выше) первой — через ~/.config/* читает всё
    # остальное, включая package.path, по которому стадия binds резолвит require.
    # colors ДО daemons, чтобы шелл нового рига стартовал уже на своей схеме, а
    # не перекрашивался на глазах. daemons предпоследней как самая медленная.
    if command -v hyprctl >/dev/null; then
        # ⚠ СТАДИЯ binds ОТКЛЮЧЕНА — роняет композитор.
        #
        # Два SIGSEGV подряд 2026-09-02, оба с одной подписью:
        #   Config::Lua::Objects::CLuaKeybind::push(lua_State*, CSharedPointer<SKeybind>)
        #   ← Config::Lua::CConfigManager::guardedPCall ← ::eval
        # Крэш-репорты: ~/.cache/hyprland/hyprlandCrashReport{35293,173}.txt
        #
        # Падает не снятие само по себе (одиночный :remove() в зонде отработал
        # чисто, 100 -> 99), а первый hl.bind ПОСЛЕ массового сноса: push
        # разыменовывает уже недействительный SKeybind. То есть __rig.drop
        # оставляет внутренний список биндов Hyprland 0.56.2 в состоянии, где
        # очередной bind сегфолтит. pcall не помогает — это падение процесса,
        # а не lua-ошибка.
        #
        # Реестр и контракт при этом исправны: на загрузке конфига дают
        # shared=14 + caelestia=85 = 99, совпадает с `hyprctl binds`.
        #
        # Путь к починке: снимать через hl.unbind(комба) вместо хендлов —
        # реестр уже хранит строку комбы рядом с хендлом. Косвенных
        # подтверждений безопасности unbind три: зонд (unbind, затем 88 биндов,
        # без падения), и годами работавший custom/keybinds.lua у end4
        # (13 unbind, следом 85 биндов). Проверять — в ОТДЕЛЬНОМ headless-
        # инстансе Hyprland, не в живой сессии.
        # stage binds      apply_rig_binds "$old" "$name"
        stage colors     apply_rig_colors "$name"
        stage animations apply_rig_animations "$name"
        stage rules      apply_rig_rules "$name"
    fi
    stage daemons swap_session_daemons "$old" "$name"
    stage state   write_last_lua "$name"

    echo "active: $name"
    return $SWITCH_FAILED
}

# Шелл и демоны рига: погасить старый, поднять новый.
swap_session_daemons() {
    local old="$1" new="$2"
    if [[ -n "$old" && -x "$PROFILES/$old/session.sh" ]]; then
        "$PROFILES/$old/session.sh" stop || true
    fi
    [[ -x "$PROFILES/$new/session.sh" ]] || return 0
    "$PROFILES/$new/session.sh" start
}

cmd_menu() {
    # Overlay-пикер (rigswitch). /usr/bin/qs абсолютным путём — исторически
    # bare `qs` ловил из PATH чужую сборку quickshell (см. eac4927). Toggle:
    # повторное нажатие бинда закрывает уже открытый overlay.
    if [[ -x /usr/bin/qs && -d "$HOME/.config/quickshell/rigswitch" ]]; then
        if pgrep -f '/usr/bin/qs -c rigswitch' >/dev/null; then
            pkill -f '/usr/bin/qs -c rigswitch'
            exit 0
        fi
        exec /usr/bin/qs -c rigswitch
    fi
    # ── fallback: старый fuzzel-путь ──
    local cur choice
    cur="$(current || true)"
    choice="$(list_profiles | sed "s/^${cur}\$/& (active)/" \
        | fuzzel --dmenu --prompt 'profile> ' --lines 4)" || exit 0
    choice="${choice% (active)}"
    [[ -z "$choice" || "$choice" == "$cur" ]] && exit 0
    cmd_switch "$choice"
}

# doctor — проверка контракта ригов. Ловит ровно тот класс поломок, из-за
# которого у end4 молча пропала GTK4-тема: каталог из CONTESTED отсутствует у
# рига, а симлинк на него всё равно стоит и указывает в никуда.
cmd_doctor() {
    local rc=0 rig d link
    for rig in $(list_profiles); do
        local missing=()
        for d in "${CONTESTED[@]}"; do
            [[ -d "$PROFILES/$rig/$d" ]] || missing+=("$d")
        done
        # lua-риг без прелюдии реестра — значит его hypr/hyprland.lua подменили
        # (так и случилось 2026-09-03: поверх легла голая копия конфига
        # апстрима). Внешне это выглядит как «бинды не мои»: набор рига и
        # контракт §2 просто не грузятся, а Hyprland про это молчит, потому
        # что подменённый файл сам по себе валиден.
        local entry="$PROFILES/$rig/hypr/hyprland.lua"
        if [[ -f "$entry" ]] && ! grep -q "hypr-shared/rigbinds.lua" "$entry"; then
            printf '%-10s hypr/hyprland.lua БЕЗ прелюдии реестра — набор биндов рига не загрузится\n' "$rig"
            printf '           восстановить: git checkout -- profiles/%s/hypr/hyprland.lua\n' "$rig"
            rc=1
        fi

        if (( ${#missing[@]} )); then
            printf '%-10s НЕТ обязательных каталогов: %s\n' "$rig" "${missing[*]}"
            rc=1
        else
            printf '%-10s ok\n' "$rig"
        fi
    done

    echo
    echo "симлинки ~/.config активного рига ($(current || echo '<none>')):"
    for d in "${CONTESTED[@]}"; do
        link="$HOME/.config/$d"
        if [[ -L "$link" && ! -e "$link" ]]; then
            printf '  %-8s БИТЫЙ -> %s\n' "$d" "$(readlink "$link")"
            rc=1
        elif [[ ! -e "$link" ]]; then
            printf '  %-8s отсутствует\n' "$d"
            rc=1
        else
            printf '  %-8s ok\n' "$d"
        fi
    done
    return $rc
}

cmd_status() {
    echo "active: $(current || echo '<none>')"
    for d in "${CONTESTED[@]}"; do
        local t; t="$(readlink "$HOME/.config/$d" 2>/dev/null || echo 'NOT A SYMLINK')"
        printf '  %-8s -> %s\n' "$d" "$t"
    done
}

# update: материализуем симлинки в реальные каталоги, чтобы чужой installer
# писал в них, потом снимаем снапшот обратно в профиль и возвращаем симлинки.
# При Ctrl+C/ошибке на любом шаге trap восстанавливает симлинки и прежний
# профиль; снапшот пишется в $d.new и подменяется атомарно, поэтому отмена
# оставляет профиль нетронутым.
# restore вызывается и из trap EXIT (вне области local), поэтому prev — глобальная.
# Best-effort: одна неудача не должна бросить остальные каталоги без симлинков.
UPDATE_PREV=""
restore() {
    [[ -n "$UPDATE_PREV" ]] && ln -sfn "$UPDATE_PREV" "$ACTIVE" || true
    for d in "${CONTESTED[@]}"; do
        if [[ -e "$HOME/.config/$d" && ! -L "$HOME/.config/$d" ]]; then
            chmod -R u+w "$HOME/.config/$d" 2>/dev/null || true
            rm -rf "$HOME/.config/${d:?}" 2>/dev/null || true
        fi
        if [[ ! -e "$HOME/.config/$d" || -L "$HOME/.config/$d" ]]; then
            ln -sfn "$PROFILES/active/$d" "$HOME/.config/$d" || true
        else
            echo "warning: не смог восстановить ~/.config/$d — убери каталог руками и запусти: dotprofile switch $UPDATE_PREV --links-only" >&2
        fi
    done
}

cmd_update() {
    local name="${1:-}"; [[ -n "$name" ]] || usage
    [[ -d "$PROFILES/$name" ]] || { echo "no such profile: $name" >&2; exit 1; }
    UPDATE_PREV="$(current || echo caelestia)"

    trap restore EXIT INT TERM

    ln -sfn "$name" "$ACTIVE"
    for d in "${CONTESTED[@]}"; do
        rm -rf "$HOME/.config/${d:?}"
        cp -a "$PROFILES/$name/$d" "$HOME/.config/$d"
    done
    echo ">>> Каталоги материализованы. Запусти installer профиля '$name'."
    echo ">>> Enter когда installer закончит (или Ctrl+C для отмены):"
    read -r

    for d in "${CONTESTED[@]}"; do
        rm -rf "$PROFILES/$name/${d:?}.new"
        cp -a "$HOME/.config/$d" "$PROFILES/$name/$d.new"
        rm -rf "$PROFILES/$name/${d:?}"
        mv "$PROFILES/$name/$d.new" "$PROFILES/$name/$d"
    done

    trap - EXIT INT TERM
    restore

    # Пост-обработка снапшота (например, вернуть source-строки, которые
    # затирает installer профиля)
    if [[ -x "$PROFILES/$name/post-update.sh" ]]; then
        "$PROFILES/$name/post-update.sh" || echo "warning: post-update.sh завершился с ошибкой" >&2
    fi
    echo "profile '$name' updated; active: $UPDATE_PREV"
}

case "${1:-}" in
    switch) shift; cmd_switch "$@" ;;
    menu)   cmd_menu ;;
    status) cmd_status ;;
    doctor) cmd_doctor ;;
    update) shift; cmd_update "$@" ;;
    # Переприменить цвета рамок активного рига (зовётся из matugen-пайплайна
    # после смены обоев)
    colors) apply_rig_colors "$(current || echo caelestia)" ;;
    *) usage ;;
esac
