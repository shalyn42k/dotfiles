#!/usr/bin/env bash
# rig-update — обновить вендоренный шелл рига до нового коммита апстрима.
#
#   rig-update serpantinum            — до origin/master
#   rig-update serpantinum <ref>      — до конкретного коммита/тега
#   rig-update serpantinum --check    — только показать, что нового, без правок
#
# Почему не кнопка «Update» в самом шелле: она пайпила install/install.sh в
# eval, а тот делает `sudo pacman -Syyu --noconfirm` и раскладывает свой конфиг
# поверх существующего — то есть поверх этого рига. Кнопка обезврежена, см.
# docs/tech-debt.md п.11.
#
# Обновление здесь — это сдвиг пина сабмодуля плюс переналожение наших патчей.
# Патчи живут в profiles/<риг>/patches/*.patch и НЕ переживают checkout сами:
# апстрим возвращает свои файлы, поэтому их накат — часть этой процедуры, а не
# то, что надо помнить руками.
set -euo pipefail

DOTFILES="$HOME/dotfiles"
PROFILES="$DOTFILES/profiles"

rig="${1:-}"
[[ -n "$rig" ]] || { echo "usage: rig-update <риг> [ref|--check]" >&2; exit 1; }
shell_dir="$PROFILES/$rig/shell"
# .git у сабмодуля — ФАЙЛ с gitdir-указателем, а не каталог, отсюда -e.
[[ -e "$shell_dir/.git" ]] || { echo "rig-update: у рига '$rig' нет вендоренного шелла" >&2; exit 1; }

target="${2:-origin/master}"
check_only=false
[[ "$target" == "--check" ]] && { check_only=true; target="origin/master"; }

current="$(git -C "$shell_dir" rev-parse HEAD)"
git -C "$shell_dir" fetch --quiet origin
resolved="$(git -C "$shell_dir" rev-parse "$target")"

if [[ "$current" == "$resolved" ]]; then
    echo "уже на $(git -C "$shell_dir" log --oneline -1 "$resolved")"
    exit 0
fi

echo "текущий:  $(git -C "$shell_dir" log --oneline -1 "$current")"
echo "целевой:  $(git -C "$shell_dir" log --oneline -1 "$resolved")"
echo
echo "коммитов между ними: $(git -C "$shell_dir" rev-list --count "$current".."$resolved" 2>/dev/null || echo '?')"
git -C "$shell_dir" log --oneline "$current".."$resolved" 2>/dev/null | head -20

if $check_only; then
    echo
    echo "(--check: ничего не менял)"
    exit 0
fi

# Локальные правки в сабмодуле — только наши патчи. Всё остальное здесь
# случайно и потерялось бы молча при checkout, поэтому останавливаемся.
if [[ -n "$(git -C "$shell_dir" status --porcelain)" ]]; then
    echo
    echo "rig-update: в сабмодуле есть незакоммиченные правки:" >&2
    git -C "$shell_dir" status --short >&2
    echo "  это ожидаемо, если там лежат наши патчи — они будут переналожены." >&2
    echo "  но если правил руками, сохрани diff перед продолжением." >&2
    read -rp "продолжить? [y/N] " ans
    [[ "$ans" == [yY] ]] || exit 1
fi

git -C "$shell_dir" checkout --quiet --force "$resolved"

# Патчи рига поверх свежего апстрима.
patches=("$PROFILES/$rig"/patches/*.patch)
if [[ -e "${patches[0]}" ]]; then
    echo
    for p in "${patches[@]}"; do
        if git -C "$shell_dir" apply --check "$p" 2>/dev/null; then
            git -C "$shell_dir" apply "$p"
            echo "патч наложен: $(basename "$p")"
        else
            echo "ПАТЧ НЕ ЛОЖИТСЯ: $(basename "$p")" >&2
            echo "  апстрим переписал этот участок — патч надо пересобрать вручную." >&2
            echo "  до тех пор кнопка Update в гайде снова запускает их инсталлер." >&2
        fi
    done
fi

# ── Страховка ───────────────────────────────────────────────────────────────
# Кнопка «Update» в гайде рига запускает ЭТОТ скрипт — но только потому, что
# патч выше её перевесил. Если апстрим перепишет тот участок и патч не ляжет,
# checkout вернёт её исходный обработчик: `curl … install.sh | eval`, то есть
# неинтерактивное обновление всей системы плюс раскладку чужого конфига поверх
# рига. Нажатие кнопки после такого обновления снесло бы настройку.
#
# Поэтому не доверяем факту «патчи применились», а проверяем результат.
if grep -rn "install/install.sh" "$shell_dir/src/quickshell" >/dev/null 2>&1; then
    echo >&2
    echo "ОПАСНО: в шелле снова есть вызов install/install.sh:" >&2
    grep -rn "install/install.sh" "$shell_dir/src/quickshell" | sed 's/^/  /' >&2
    echo >&2
    echo "  Это значит, что патч не лёг, и кнопка Update снова запускает их" >&2
    echo "  инсталлер. НЕ НАЖИМАЙ ЕЁ. Пересобери патч:" >&2
    echo "    \$EDITOR $shell_dir/src/quickshell/guide/AboutTab.qml" >&2
    echo "    git -C $shell_dir diff > $PROFILES/$rig/patches/0001-disarm-update-button.patch" >&2
    exit 1
fi

# Шелл держит QML в памяти: без перезапуска обновление визуально «не приехало»,
# а свежий патч кнопки не действует.
echo
if [[ "$(basename "$(readlink -f "$PROFILES/active")")" == "$rig" ]]; then
    echo "перезапускаю шелл, чтобы новая версия и патчи вступили в силу…"
    "$DOTFILES/bin/rigdo" shell >/dev/null 2>&1 || true
else
    echo "риг не активен — шелл перезапустится сам при следующем входе в него"
fi

echo
echo "готово. Осталось зафиксировать пин:"
echo "  git -C $DOTFILES add profiles/$rig/shell"
echo "  git -C $DOTFILES commit -m 'chore($rig): bump vendored shell to ${resolved:0:7}'"
