# АВТОГЕН matugen — не править руками.
# Читается bin/dotprofile apply_rig_colors (awk по $active_border)
# и profiles/serpantinum/hypr/group.lua (парсит $gb_*).
$active_border = rgba({{colors.primary.default.hex_stripped}}ee)
$inactive_border = rgba({{colors.outline_variant.default.hex_stripped}}55)

# Плашка вкладок (ALT+Q). Отдельные переменные, а не переиспользование рамок:
# рамке нужна яркость на тонкой линии (ee), заливке вкладки — нет (d4), а текст
# на ней обязан контрастировать с primary, то есть быть именно on_primary.
$gb_active = rgba({{colors.primary.default.hex_stripped}}d4)
$gb_inactive = rgba({{colors.outline.default.hex_stripped}}d4)
$gb_locked_inactive = rgba({{colors.secondary.default.hex_stripped}}d4)
$gb_text = rgb({{colors.on_primary.default.hex_stripped}})
