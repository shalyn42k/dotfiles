--- a/src/assets/matugen/config.toml
+++ b/src/assets/matugen/config.toml
@@ -5,9 +5,12 @@
 input_path = "templates/serpantinum_matugen_colors.json.template"
 output_path = "~/.local/state/serpantinum/qs_colors.json"
 
-[templates.fastfetch]
-input_path = "templates/fastfetch.jsonc.template"
-output_path = "~/.config/fastfetch/config.jsonc"
+# ── ЛОКАЛЬНЫЙ ПАТЧ dotfiles ──────────────────────────────────────────────────
+# [templates.fastfetch] убран. Он писал в ~/.config/fastfetch/config.jsonc, а
+# это симлинк в репозиторий dotfiles, где тот же файл генерит из своего шаблона
+# bin/dotprofile (apply_rig_colors). Каждая смена обоев подменяла наш баннер
+# версией шелла — правки в нашем шаблоне жили до первой смены обоев.
+# Соседний config-static.toml пишет fastfetch.jsonc, другое имя, не конфликтует.
 
 [templates.kitty]
 input_path = "templates/kitty-colors.conf.template"
--- a/install/modules/deploy.sh
+++ b/install/modules/deploy.sh
@@ -6,9 +6,11 @@
 # копирование апстримового конфига писало бы прямо в git-дерево и затирало
 # локальный kitty.conf. Апстримовые kitty-настройки нам и не нужны: свои живут
 # в репе. Остальные записи оставлены как есть — их каталоги обычные.
+# "fastfetch" убран по той же причине, вторым патчем: ~/.config/fastfetch тоже
+# симлинк в репо, а баннер там генерит bin/dotprofile из своего шаблона.
+# "cava" оставлен намеренно — ~/.config/cava обычный каталог, не симлинк.
 EXTRA_CONFIGS=(
     "cava"
-    "fastfetch"
 )
 
