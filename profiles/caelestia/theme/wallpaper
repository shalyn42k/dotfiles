#!/usr/bin/env bash
# Путь к текущим обоям caelestia.
#
# Исполняемый файл, а не симлинк: caelestia хранит не сам файл, а ПУТЬ текстом,
# и путь меняется на каждую смену обоев. Статический симлинк за этим не
# угонится, а держать его актуальным пришлось бы ещё одним path-юнитом.
set -u
cat "$HOME/.local/state/caelestia/wallpaper/path.txt" 2>/dev/null
