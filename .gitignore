.DS_Store
*.log
__pycache__
.venv
.mypy_cache
.superpowers/
profiles/active
profiles/.last-lua
# секреты его виджетов (API-ключи) — живут только локально
profiles/*/hypr/scripts/quickshell/calendar/.env
# генерится dotprofile colors из config.jsonc.template
.config/fastfetch/config.jsonc
# рендерится matugen'ом рига на каждую смену темы (оба рига пишут сюда же)
.config/kitty/kitty-matugen-colors.conf
# то же самое, но пишет matugen ВЕНДОРЕННОГО шелла serpantinum
# (src/assets/matugen/config-static.toml). ~/.config/fastfetch — симлинк в репо,
# поэтому его генерация падает прямо в рабочее дерево.
# Соседний .config/kitty/colors.conf — из того же источника, но оставлен
# отслеживаемым намеренно: kitty.conf делает на него безусловный include.
.config/fastfetch/fastfetch.jsonc

# ── Машинное состояние: у каждого своё, в репо ему делать нечего ──────────
# fisher пишет сюда сам; декларативный источник истины — .config/fish/fish_plugins
.config/fish/fish_variables
# caelestia shell перезаписывает файл на каждую правку в его GUI, плюс держит
# личное (город погоды, VPN, избранные приложения). Канон — shell.json.in ниже.
.config/caelestia/shell.json
# per-monitor оверрайды caelestia под имена ВЫХОДОВ конкретной машины
# (eDP-1/HDMI-A-1/...) — у чужого железа выходы называются иначе
.config/caelestia/monitors/

# ── Рендерится bootstrap.sh из соседнего *.in ────────────────────────────
# Абсолютный $HOME внутрь не подставить иначе: эти каталоги приезжают в
# ~/.config симлинком, а GTK-закладки, qt*ct.conf и @import в CSS не умеют
# ни ~, ни переменные окружения.
# канон закладок; profiles/caelestia/gtk-3.0/bookmarks.in — симлинк на .in рядом
.config/gtk-shared/bookmarks
profiles/*/gtk-3.0/bookmarks
profiles/serpantinum/gtk-3.0/gtk.css
profiles/serpantinum/gtk-4.0/gtk.css
profiles/*/qt5ct/qt5ct.conf
profiles/*/qt6ct/qt6ct.conf
